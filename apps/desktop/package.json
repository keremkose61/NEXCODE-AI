{
  "name": "@nexcode/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "description": "NEXCODE AI – Professional Local Desktop IDE. Code Smarter. Build Beyond.",
  "author": "NEXCODE AI Team",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "start": "electron .",
    "package:win": "electron-builder --win",
    "package:dir": "electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.nexcode.ai",
    "productName": "NEXCODE AI",
    "copyright": "Copyright © 2026 NEXCODE AI Team",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "NEXCODE AI",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@nexcode/editor": "workspace:*",
    "@nexcode/file-explorer": "workspace:*",
    "@nexcode/git-manager": "workspace:*",
    "@nexcode/shared": "workspace:*",
    "@nexcode/terminal": "workspace:*",
    "@nexcode/ui": "workspace:*",
    "lucide-react": "^0.460.0",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
